# Port yang dipakai manager ini (beda dari port Adin MD utama kalau satu server)
PORT=3300

# Domain frontend Vercel kamu, biar CORS-nya diizinkan. Pisah pakai koma kalau lebih dari satu.
# Contoh: https://jadibot-adinmd.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Batas maksimal sub-bot yang boleh hidup bersamaan (biar server nggak kewalahan)
MAX_CONCURRENT_BOTS=20

# Batas berapa kali satu IP boleh nge-start bot dalam 1 jam (anti-spam)
RATE_LIMIT_PER_IP_PER_HOUR=5

# Path ke file service account Firebase (buat login & database user).
# Download dari Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
